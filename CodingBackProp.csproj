<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>CodingBackProp</RootNamespace>
    <AssemblyName>CodingBackProp</AssemblyName>
  </PropertyGroup>

  <!-- Exclude subfolders from the root project so it builds BackPropProgram Final.cs cleanly -->
  <ItemGroup>
    <Compile Remove="Original Code/**" />
    <Compile Remove="Encapsulated Code/**" />
    <Compile Remove="*backup*/**" />
  </ItemGroup>

</Project>
